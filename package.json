{
  "name": "brighter-nexus",
  "productName": "Brighter Nexus",
  "version": "0.5.1",
  "description": "Plataforma educativa para pantallas interactivas BTOUCH: pizarra, kit de actividades y biblioteca 3D",
  "private": true,
  "type": "module",
  "author": "Brighter Perú S.A.C.",
  "license": "UNLICENSED",
  "scripts": {
    "servir": "node herramientas/servir.js",
    "pruebas": "node pruebas/probar-puntaje.js && node pruebas/probar-modelos.js",
    "prueba:prototipo": "node pruebas/probar-prototipo.mjs",
    "kit": "node herramientas/verificar-kit.js",
    "modelos": "node herramientas/modelos.js",
    "modelos:licitacion": "node herramientas/modelos.js --licitacion",
    "medir:modelos": "node pruebas/medir-modelos.mjs",
    "pc": "electron .",
    "instalador": "electron-builder --win nsis --x64",
    "celular:sincronizar": "cap sync android"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "@capacitor/cli": "^6.2.2",
    "electron": "^26.6.10",
    "electron-builder": "^24.13.3"
  },
  "main": "pc/principal.cjs",
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2"
  },
  "build": {
    "appId": "pe.brighter.nexus",
    "productName": "Brighter Nexus",
    "directories": {
      "output": "instaladores",
      "buildResources": "recursos"
    },
    "files": [
      "pc/**",
      "app/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "recursos/icono.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Brighter Nexus",
      "artifactName": "Brighter Nexus Setup ${version}.${ext}"
    }
  }
}